# Copia este archivo como .env y llena SOLO la clave del proveedor que uses.
# .env está en .gitignore: nunca subas tus claves al repositorio.

# Proveedor principal: groq | nvidia | ollama
LLM_PROVIDER=groq
# Modelo (opcional). Si se deja vacío se usa el sugerido en src/llm.py;
# verifica en la consola de tu proveedor que el modelo siga disponible.
LLM_MODEL=
# Proveedor alterno si el principal falla (opcional, p. ej. ollama local)
LLM_PROVIDER_ALT=

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
# NVIDIA NIM: https://build.nvidia.com
NVIDIA_API_KEY=
# Ollama no necesita clave: instala Ollama y corre `ollama pull qwen2.5:7b`
